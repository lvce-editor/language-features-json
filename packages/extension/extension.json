{
  "id": "builtin.language-features-json",
  "name": "Language Features json",
  "description": "Provides rich language support for JSON files",
  "activation": [
    "onLanguage:json",
    "onCompletion:json",
    "onDiagnostic:json",
    "onTabCompletion:json",
    "onHover:json"
  ],
  "browser": "dist/languageFeaturesJsonMain.js",
  "isolated": true,
  "icon": "./icon.png",
  "commands": [],
  "completionProviders": [
    {
      "id": "json.provideCompletions.json",
      "languageId": "json"
    }
  ],
  "diagnosticProviders": [
    {
      "id": "json.provideDiagnostics.json",
      "languageId": "json"
    }
  ],
  "hoverProviders": [
    {
      "id": "json.provideHover.json",
      "languageId": "json"
    }
  ],
  "languages": [
    {
      "id": "json",
      "extensions": [".json"]
    }
  ],
  "repository": "https://github.com/lvce-editor/language-features-json"
}
